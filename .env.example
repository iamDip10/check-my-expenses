# --- Database (Vercel Postgres / Neon / Supabase — any Postgres works) ---
# Pooled connection string used by the app at runtime
DATABASE_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true"
# Direct (non-pooled) connection string used only for migrations
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# Your deployed URL in production, http://localhost:3000 locally
NEXTAUTH_URL="http://localhost:3000"

# --- The two accounts (used only by prisma/seed.ts to create the users) ---
OWNER_NAME="Dip"
OWNER_EMAIL="dip@example.com"
OWNER_PASSWORD="choose-a-strong-password"

MONITOR_NAME="Wife"
MONITOR_EMAIL="wife@example.com"
MONITOR_PASSWORD="choose-a-strong-password"
